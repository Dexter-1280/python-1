total=500
football=49*total/100
hockey=53*total/100
basketball=62*total/100
fh=27*total/100
hb=29* total/100
fb=28*total/100


# In[18]:


none=5*total/100
atleastone=total-none
allthree=atleastone-(football+hockey+basketball)+(fh+hb+fb)


# In[22]:


print("Students who like all three games =", int(allthree))
onlyf=football-fh-fb+allthree
onlyh=hockey-fh-hb+allthree
onlyb=basketball-fb-hb+allthree
print("Only Football =", int(onlyf))
print("Only Hockey =", int(onlyh))
print("Only Basketball =", int(onlyb))
print("Ratio of Only Football : Only Hockey =",
int(onlyf), ":", int(onlyh))
onlyone = onlyf + onlyh + onlyb
print("Students who like only one game=", int(onlyone))
atleasttwo = fh + hb + fb - (2 * allthree)
print("Students who like at least two game=", int(atleasttwo))


